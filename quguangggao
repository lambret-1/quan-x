[mitm]
hostname = pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao.com, p6-ad-sign.byteimg.com, snssdk.com, *.snssdk.com, byteimg.com, *.byteimg.com, adkwai.com, *.adkwai.com, log-api.pangolin-sdk-toutiao-b.com, p1-lm.adkwai.com, open.e.kuaishou.com

[rewrite_local]
# 穿山甲广告专用
^https?://.*\.pangolin-sdk-toutiao\.com/.*$ url reject-200
^https?://p6-ad-sign\.byteimg\.com/.*$ url reject-200
^https?://log-api\.pangolin-sdk-toutiao-b\.com/.*$ url reject-200

# 快手广告专用
^https?://.*\.adkwai\.com/.*$ url reject-200
^https?://p1-lm\.adkwai\.com/.*$ url reject-200
^https?://open\.e\.kuaishou\.com/.*$ url reject-200

# 字节系通用大域名（精准打击，防误伤）
^https?://.*\.byteimg\.com/.*(ad|advert|banner|splash).*\.(jpg|jpeg|png|gif|webp)(\?.*)?$ url reject-img
^https?://.*\.snssdk\.com/.*(ad|advert|banner|splash).*\.(jpg|jpeg|png|gif|webp)(\?.*)?$ url reject-img
